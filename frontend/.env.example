# Backend API (browser)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Map tiles (OpenStreetMap by default — no key required)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Vercel only (Project → Settings → Environment Variables) ---
# Full health URL the cron pings every 5 minutes
# BACKEND_HEALTH_URL=https://your-django-api.onrender.com/api/health/
# Shared secret; Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=generate-a-long-random-string
