# =============================================================================
# FRONTEND — copy values into Vercel project: weather-truck-routing-two
# Settings → Environment Variables → then Redeploy
# Type: Config (not Secret) for all VITE_ vars
# =============================================================================

# REQUIRED on Vercel (must end with /api)
VITE_API_BASE_URL=https://weather-truck-routing-l783.vercel.app/api

# Map tiles (OpenStreetMap — no key required)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Optional — Vercel cron / health keepalive
BACKEND_HEALTH_URL=https://weather-truck-routing-l783.vercel.app/api/health/
CRON_SECRET=generate-a-long-random-string

# Local dev only (override in frontend/.env — not committed):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
