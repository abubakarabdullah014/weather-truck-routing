# =============================================================================
# BACKEND — copy values into Vercel project: weather-truck-routing-l783
# Root Directory: backend
# Settings → Environment Variables → then Redeploy
# =============================================================================

# Django (DJANGO_SECRET_KEY + ORS_API_KEY → type Secret; rest → Config)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Frontend origins allowed to call this API (comma-separated, no spaces preferred)
CORS_ALLOWED_ORIGINS=https://weather-truck-routing-two.vercel.app,https://weather-truck-sandy.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_VERCEL_PREVIEWS=True

# Routing (OpenRouteService — free key: https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=paste-your-ors-key-here
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding (Nominatim / OpenStreetMap)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=WeatherTruckRouting/1.0 (abubakarabdullah014)

# Weather (Open-Meteo — no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Defaults
DEFAULT_SAMPLE_INTERVAL_MILES=25
