# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://weather-truck-sandy.vercel.app
# Optional: allow all Vercel preview URLs (set in settings via CORS_ALLOWED_ORIGIN_REGEXES)
CORS_ALLOW_VERCEL_PREVIEWS=True

# On the FRONTEND Vercel project (not backend), set and Redeploy:
# VITE_API_BASE_URL=https://YOUR-BACKEND-PROJECT.vercel.app/api

# Routing (OpenRouteService — free key at https://openrouteservice.org/dev/#/signup)
# Falls back to public OSRM if unset
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding (Nominatim / OpenStreetMap)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=WeatherTruckRouting/1.0 (contact@example.com)

# Weather (Open-Meteo — no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Defaults
DEFAULT_SAMPLE_INTERVAL_MILES=25
