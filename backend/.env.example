# =============================================================================
# BACKEND Vercel project — domain: https://backend-ten-gilt-82.vercel.app
# Root Directory: backend → Redeploy after saving env vars
# =============================================================================

# Django (SECRET + ORS_API_KEY = Secret type; rest = Config)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,backend-ten-gilt-82.vercel.app,localhost,127.0.0.1

# Allow your frontend(s)
CORS_ALLOWED_ORIGINS=https://weather-truck-routing-two.vercel.app,https://weather-truck-sandy.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_VERCEL_PREVIEWS=True

# Routing
ORS_API_KEY=paste-your-ors-key-here
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=WeatherTruckRouting/1.0 (abubakarabdullah014)

# Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

DEFAULT_SAMPLE_INTERVAL_MILES=25
