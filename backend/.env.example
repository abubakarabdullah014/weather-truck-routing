# =============================================================================
# BACKEND — set these in Vercel Environment Variables (do NOT commit real secrets)
# Root Directory: backend
# =============================================================================

# Django — set real values only in Vercel / local .env (gitignored)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://frontend-nine-chi-u07luqtijn.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_VERCEL_PREVIEWS=True

# Routing — get a free key at https://openrouteservice.org/dev/#/signup
# Put the real key only in Vercel Secret / local .env — leave blank here
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=WeatherTruckRouting/1.0

# Weather (no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

DEFAULT_SAMPLE_INTERVAL_MILES=25
